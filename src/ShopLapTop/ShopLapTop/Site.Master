<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="ShopLapTop.SiteMaster" %>

<!DOCTYPE html>
<html lang="vi">
<head runat="server">
    <meta charset="utf-8" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - Shop Laptop</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#2563eb',
                        secondary: '#1e40af'
                    },
                    fontFamily: {
                        sans: ['Be Vietnam Pro', 'sans-serif']
                    }
                }
            }
        }
    </script>
    <style>
        body { font-family: 'Be Vietnam Pro', sans-serif; }
        /* CheckBoxList admin - hien thi ngang dep hon */
        span[id*="cblNhuCau"], span[id*="cblThuongHieu"] label {
            display: inline-flex; align-items: center; gap: 4px;
            margin-right: 12px; margin-bottom: 6px;
            padding: 4px 10px; background: #f8fafc; border-radius: 8px;
            border: 1px solid #e2e8f0; font-size: 13px; cursor: pointer;
        }
        span[id*="cblNhuCau"] input, span[id*="cblThuongHieu"] input { margin: 0; }
    </style>
    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>
</head>
<body class="bg-slate-50 min-h-screen flex flex-col antialiased">
    <form id="form1" runat="server">
        <header class="bg-white shadow-sm sticky top-0 z-50 border-b border-slate-100">
            <div class="container mx-auto px-4 py-3 max-w-7xl">
                <div class="flex items-center justify-between gap-4">
                    <a href='<%= ResolveUrl("~/Index.aspx") %>' class="flex items-center gap-2.5 flex-shrink-0">
                        <span class="w-9 h-9 bg-blue-100 text-primary rounded-lg flex items-center justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                            </svg>
                        </span>
                        <span class="text-xl font-bold text-primary">Shop Laptop</span>
                    </a>

                    <%-- Search bar header --%>
                    <div class="hidden md:flex items-center flex-1 max-w-sm mx-4">
                        <div class="relative w-full">
                            <input type="text" id="headerSearch" placeholder="Tìm kiếm laptop..."
                                class="w-full pl-4 pr-10 py-2 text-sm bg-slate-100 rounded-xl border-0 focus:outline-none focus:ring-2 focus:ring-primary focus:bg-white transition" />
                            <button type="button" onclick="doHeaderSearch()"
                                class="absolute right-0 top-0 h-full px-3 text-slate-400 hover:text-primary">
                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                                </svg>
                            </button>
                        </div>
                    </div>

                    <nav class="hidden md:flex items-center gap-5 flex-wrap justify-end">
                        <a href='<%= ResolveUrl("~/Index.aspx") %>' class="text-slate-600 hover:text-primary font-medium transition">Trang chủ</a>
                        <a href='<%= ResolveUrl("~/ProductList.aspx") %>' class="text-slate-600 hover:text-primary font-medium transition">Sản phẩm</a>
                        <a href='<%= ResolveUrl("~/GioHang.aspx") %>' class="text-slate-600 hover:text-primary font-medium flex items-center gap-1.5 transition">
                            Giỏ hàng
                            <span id="soLuongGio" class="bg-red-500 text-white text-xs rounded-full min-w-[20px] h-5 flex items-center justify-center px-1.5"><%= SoLuongGioHang %></span>
                        </a>
                        <asp:Panel ID="pnlChuaDangNhap" runat="server" CssClass="flex items-center gap-3">
                            <a href='<%= ResolveUrl("~/DangNhap.aspx") %>' class="text-slate-600 hover:text-primary font-medium transition">Đăng nhập</a>
                            <a href='<%= ResolveUrl("~/DangKy.aspx") %>' class="bg-primary text-white px-4 py-2 rounded-lg hover:bg-secondary transition font-medium">Đăng ký</a>
                        </asp:Panel>
                        <asp:Panel ID="pnlDaDangNhap" runat="server" Visible="false" CssClass="relative flex items-center">
                            <button type="button" onclick="toggleUserMenu(event)"
                                class="flex items-center gap-1.5 text-slate-600 hover:text-primary font-medium transition py-1.5 px-2.5 rounded-lg hover:bg-slate-50 select-none">
                                <svg class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                </svg>
                                <asp:Literal ID="litTenND" runat="server" />
                                <svg class="w-3.5 h-3.5 opacity-50 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                                </svg>
                            </button>
                            <div id="userMenu" class="hidden absolute right-0 top-full mt-1 w-56 bg-white rounded-xl shadow-lg border border-slate-100 py-1.5 z-50">
                                <a href='<%= ResolveUrl("~/ThongTin.aspx") %>' class="flex items-center gap-2.5 px-4 py-2.5 text-sm text-slate-700 hover:bg-slate-50 transition">
                                    <svg class="w-4 h-4 text-slate-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                    </svg>
                                    Thông tin cá nhân
                                </a>
                                <a href='<%= ResolveUrl("~/DoiMatKhau.aspx") %>' class="flex items-center gap-2.5 px-4 py-2.5 text-sm text-slate-700 hover:bg-slate-50 transition">
                                    <svg class="w-4 h-4 text-slate-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
                                    </svg>
                                    Đổi mật khẩu
                                </a>
                                <a href='<%= ResolveUrl("~/LichSuDonHang.aspx") %>' class="flex items-center gap-2.5 px-4 py-2.5 text-sm text-slate-700 hover:bg-slate-50 transition">
                                    <svg class="w-4 h-4 text-slate-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                                    </svg>
                                    Lịch sử đơn hàng
                                </a>
                                <asp:Panel ID="pnlAdmin" runat="server" Visible="false">
                                    <div class="border-t border-slate-100 my-1"></div>
                                    <a href='<%= ResolveUrl("~/Admin/Default.aspx") %>' class="flex items-center gap-2.5 px-4 py-2.5 text-sm text-emerald-700 hover:bg-emerald-50 transition">
                                        <svg class="w-4 h-4 text-emerald-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                        </svg>
                                        Quản trị
                                    </a>
                                </asp:Panel>
                                <div class="border-t border-slate-100 my-1"></div>
                                <asp:LinkButton ID="btnDangXuat" runat="server" OnClick="btnDangXuat_Click"
                                    CausesValidation="false"
                                    CssClass="flex w-full items-center gap-2.5 px-4 py-2.5 text-sm text-red-500 hover:bg-red-50 transition">
                                    <svg class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                                    </svg>
                                    Đăng xuất
                                </asp:LinkButton>
                            </div>
                        </asp:Panel>
                    </nav>

                    <button type="button" id="btnMenu" class="md:hidden text-slate-700 p-2 rounded-lg hover:bg-slate-100">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
                        </svg>
                    </button>
                </div>

                <div id="mobileNav" class="hidden md:hidden mt-3 pb-2 border-t border-slate-100 pt-3 space-y-1">
                    <div class="flex gap-2 mb-2">
                        <input type="text" id="mobileSearch" placeholder="Tìm kiếm laptop..."
                            class="flex-1 pl-3 pr-2 py-2 text-sm bg-slate-100 rounded-xl border-0 focus:outline-none focus:ring-2 focus:ring-primary" />
                        <button type="button" onclick="doMobileSearch()" class="bg-primary text-white px-3 py-2 rounded-xl text-sm">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                        </button>
                    </div>
                    <a href='<%= ResolveUrl("~/Index.aspx") %>' class="block py-2 px-2 text-slate-700 rounded-lg hover:bg-slate-50">Trang chủ</a>
                    <a href='<%= ResolveUrl("~/ProductList.aspx") %>' class="block py-2 px-2 text-slate-700 rounded-lg hover:bg-slate-50">Sản phẩm</a>
                    <a href='<%= ResolveUrl("~/GioHang.aspx") %>' class="block py-2 px-2 text-slate-700 rounded-lg hover:bg-slate-50">Giỏ hàng (<%= SoLuongGioHang %>)</a>
                    <a href='<%= ResolveUrl("~/DangNhap.aspx") %>' class="block py-2 px-2 text-slate-700 rounded-lg hover:bg-slate-50">Đăng nhập</a>
                    <a href='<%= ResolveUrl("~/DangKy.aspx") %>' class="block py-2 px-2 text-slate-700 rounded-lg hover:bg-slate-50">Đăng ký</a>
                    <a href='<%= ResolveUrl("~/ThongTin.aspx") %>' class="block py-2 px-2 text-slate-700 rounded-lg hover:bg-slate-50">Thông tin cá nhân</a>
                    <a href='<%= ResolveUrl("~/DoiMatKhau.aspx") %>' class="block py-2 px-2 text-slate-700 rounded-lg hover:bg-slate-50">Đổi mật khẩu</a>
                    <a href='<%= ResolveUrl("~/LichSuDonHang.aspx") %>' class="block py-2 px-2 text-slate-700 rounded-lg hover:bg-slate-50">Lịch sử đơn hàng</a>
                </div>
            </div>
        </header>

        <main class="flex-1 container mx-auto px-4 py-8 max-w-7xl">
            <asp:ContentPlaceHolder ID="MainContent" runat="server" />
        </main>

        <footer class="bg-slate-800 text-white mt-auto">
            <div class="container mx-auto px-4 py-8 max-w-7xl">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <div>
                        <h3 class="text-lg font-bold mb-2">Shop Laptop</h3>
                        <p class="text-slate-400 text-sm">Cửa hàng laptop uy tín, giá tốt nhất thị trường.</p>
                    </div>
                    <div>
                        <h3 class="text-lg font-bold mb-2">Liên hệ</h3>
                        <p class="text-slate-400 text-sm">Tel: 0901 234 567</p>
                        <p class="text-slate-400 text-sm">Email: support@shoplaptop.vn</p>
                    </div>
                    <div>
                        <h3 class="text-lg font-bold mb-2">Địa chỉ</h3>
                        <p class="text-slate-400 text-sm">123 Đường ABC, Quận 1, TP.HCM</p>
                    </div>
                </div>
                <div class="border-t border-slate-700 mt-6 pt-4 text-center text-slate-500 text-sm">
                    &copy; 2026 Shop Laptop - Dự án ASP.NET Web Forms
                </div>
            </div>
        </footer>
    </form>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#btnMenu').click(function () {
                $('#mobileNav').slideToggle(200);
            });
        });
        function toggleUserMenu(e) {
            e.stopPropagation();
            document.getElementById('userMenu').classList.toggle('hidden');
        }
        document.addEventListener('click', function (e) {
            var menu = document.getElementById('userMenu');
            if (menu && !menu.previousElementSibling.contains(e.target)) {
                menu.classList.add('hidden');
            }
        });

        var productListUrl = '<%= ResolveUrl("~/ProductList.aspx") %>';
        function doHeaderSearch() {
            var kw = document.getElementById('headerSearch').value.trim();
            window.location.href = productListUrl + (kw ? '?kw=' + encodeURIComponent(kw) : '');
        }
        function doMobileSearch() {
            var kw = document.getElementById('mobileSearch').value.trim();
            window.location.href = productListUrl + (kw ? '?kw=' + encodeURIComponent(kw) : '');
        }
        document.addEventListener('DOMContentLoaded', function () {
            var hs = document.getElementById('headerSearch');
            if (hs) hs.addEventListener('keypress', function (e) { if (e.key === 'Enter') doHeaderSearch(); });
            var ms = document.getElementById('mobileSearch');
            if (ms) ms.addEventListener('keypress', function (e) { if (e.key === 'Enter') doMobileSearch(); });
        });
    </script>
    <asp:ContentPlaceHolder ID="scripts" runat="server"></asp:ContentPlaceHolder>
</body>
</html>
